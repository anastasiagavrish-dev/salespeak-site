[Unit]
Description=salespeak.ru – прием заявок и админка
After=network.target

[Service]
User=salespeak
WorkingDirectory=/opt/salespeak/backend
EnvironmentFile=/etc/salespeak.env
ExecStart=/opt/salespeak/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8100 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
