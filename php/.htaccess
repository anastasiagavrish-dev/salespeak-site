DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset utf-8
AddType application/xml .xml

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?salespeak\.ru$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.a-gavrish\.com$ [NC]
RewriteRule ^(.*)$ https://a-gavrish.com/$1 [R=301,L]
RewriteRule ^script/?$ https://a-gavrish.com/uslugi/skripty/ [R=301,L]
RewriteRule ^training/?$ https://a-gavrish.com/uslugi/treningi/ [R=301,L]
RewriteRule ^(new|test)/?$ https://a-gavrish.com/ [R=301,L]
RewriteRule ^page56506087\.html$ https://a-gavrish.com/ [R=301,L]
RewriteRule ^page78263846\.html$ https://a-gavrish.com/ [R=301,L]
RewriteRule ^page148181243\.html$ https://a-gavrish.com/ [R=301,L]
RewriteRule ^page57328991\.html$ https://a-gavrish.com/cases/ [R=301,L]
RewriteRule ^page57328719\.html$ https://a-gavrish.com/cases/cosmetic/ [R=301,L]
RewriteRule ^page59665185\.html$ https://a-gavrish.com/cases/b2b-case/ [R=301,L]
RewriteRule ^page57477639\.html$ https://a-gavrish.com/about/ [R=301,L]
RewriteRule ^page58898415\.html$ https://a-gavrish.com/uslugi/skripty/ [R=301,L]
RewriteRule ^page60733515\.html$ https://a-gavrish.com/uslugi/treningi/ [R=301,L]
RewriteRule ^page69674949\.html$ https://a-gavrish.com/cases/africa/ [R=301,L]
RewriteRule ^page70970525\.html$ https://a-gavrish.com/cases/business-travels/ [R=301,L]
RewriteRule ^page70982473\.html$ https://a-gavrish.com/cases/detskaya-odezhda/ [R=301,L]
RewriteRule ^page70984763\.html$ https://a-gavrish.com/cases/gynecology/ [R=301,L]
RewriteRule ^page71731505\.html$ https://a-gavrish.com/cases/events-equipment/ [R=301,L]
RewriteRule ^page71732017\.html$ https://a-gavrish.com/cases/bigtech/ [R=301,L]
RewriteRule ^page71733105\.html$ https://a-gavrish.com/cases/kpi-za-3-dnya/ [R=301,L]
RewriteRule ^page72114641\.html$ https://a-gavrish.com/cases/marketplaces/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cases/(africa|business-travels|detskaya-odezhda|gynecology|events-equipment|bigtech|kpi-za-3-dnya|marketplaces)/?$ https://a-gavrish.com/cases/ [R=302,L]
RewriteRule ^(_app|_data)(/|$) - [F,L]
RewriteRule ^api/lead/?$ api/lead.php [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(woff2|webp|jpg|svg|css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(html|txt|xml)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
